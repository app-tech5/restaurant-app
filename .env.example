# Copy to .env and adjust locally (`.env` is gitignored).
# Expo inlines EXPO_PUBLIC_* at Metro start — restart Metro after changes.
#
#   cp .env.example .env
#   npm run start:demo:localhost   # DEMO ON  (writes .env.local)
#   npm run start:live:localhost   # DEMO OFF (writes .env.local)
#
# Do not set EXPO_PUBLIC_DEMO_MODE in `.env` — use the start:* scripts.

EXPO_PUBLIC_DEMO_EMAIL=demo@restaurant.com
EXPO_PUBLIC_DEMO_PASSWORD=password123
EXPO_PUBLIC_API_URL=http://localhost:5000/api
