{
  "expo": {
    "name": "Good Food Restaurant",
    "slug": "good-food-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo512.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goodfood.restaurant",
      "buildNumber": "1.0.0",
      "requireFullScreen": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to manage restaurant locations",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo512.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.goodfood.restaurant",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo512.png",
      "name": "Good Food Restaurant",
      "shortName": "Good Food",
      "lang": "fr-FR",
      "scope": "/",
      "themeColor": "#ffffff",
      "description": "Good Food restaurant management application"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-location"
    ],
    "jsEngine": "hermes",
    "locales": {
      "fr": "./lang/fr.json",
      "en": "./lang/en.json"
    },
    "scheme": "goodfoodrestaurant",
    "extra": {
      "apiUrl": "https://api.goodfood.com",
      "eas": {
        "projectId": "6b3b8f77-601a-4cbf-91d1-b02974943033"
      }
    },
    "primaryColor": "#FF6B35"
  }
}
