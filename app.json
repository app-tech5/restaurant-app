{
  "expo": {
    "name": "Good Food Pro Restaurant",
    "slug": "good-food-restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo512.png",
    "userInterfaceStyle": "light",
    "scheme": "goodfoodrestaurant",
    "splash": {
      "image": "./assets/images/splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goodfood.restaurant",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Good Food Pro Restaurant uses your location to manage restaurant locations.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo512.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.goodfood.restaurant",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-location",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "jsEngine": "hermes",
    "locales": {
      "fr": "./lang/fr.json",
      "en": "./lang/en.json"
    },
    "primaryColor": "#FF6B35"
  }
}
